{\n  \"framework_version\": \"2.0\",\n  \"framework_date\": \"2026-05-28\",\n  \"reference\": \"https://openai.com/index/updating-our-preparedness-framework/\",\n  \n  \"risk_categories\": {\n    \"biological_chemical\": {\n      \"name\": \"Biological and Chemical Risks\",\n      \"description\": \"Risks from advancements that could lower barriers to creating or using biological/chemical weapons\",\n      \"threshold\": 5,\n      \"measurement_criteria\": {\n        \"plausible\": true,\n        \"measurable\": true,\n        \"severe\": true,\n        \"net_new\": true,\n        \"instantaneous_or_irremediable\": true\n      },\n      \"mitigations\": [\n        \"Input filtering for sensitive queries\",\n        \"Output restrictions on dual-use information\",\n        \"Audit logging for compliance\",\n        \"Access controls for sensitive code\",\n        \"Continuous monitoring and alerting\"\n      ]\n    },\n    \"cybersecurity\": {\n      \"name\": \"Cybersecurity Risks\",\n      \"description\": \"Risks from frontier AI being used for large-scale cyberattacks or discovering new vulnerabilities\",\n      \"threshold\": 5,\n      \"measurement_criteria\": {\n        \"plausible\": true,\n        \"measurable\": true,\n        \"severe\": true,\n        \"net_new\": true,\n        \"instantaneous_or_irremediable\": true\n      },\n      \"mitigations\": [\n        \"Vulnerability scanning in CI/CD pipeline\",\n        \"Code analysis for security flaws\",\n        \"Penetration testing before deployment\",\n        \"Security patching protocols\",\n        \"Incident response procedures\",\n        \"Rate limiting and resource constraints\"\n      ]\n    },\n    \"ai_self_improvement\": {\n      \"name\": \"AI Self-Improvement Risks\",\n      \"description\": \"Risks from AI systems improving their own capabilities beyond human oversight\",\n      \"threshold\": 5,\n      \"measurement_criteria\": {\n        \"plausible\": true,\n        \"measurable\": true,\n        \"severe\": true,\n        \"net_new\": true,\n        \"instantaneous_or_irremediable\": true\n      },\n      \"mitigations\": [\n        \"Capability monitoring dashboards\",\n        \"Human-in-the-loop approval for changes\",\n        \"Behavioral baselines and anomaly detection\",\n        \"Resource limits and rate throttling\",\n        \"Regular capability audits\",\n        \"Immutable logs of all modifications\"\n      ]\n    }\n  },\n\n  \"research_categories\": {\n    \"autonomous_adaptation\": {\n      \"name\": \"Autonomous Adaptation\",\n      \"status\": \"monitoring\",\n      \"description\": \"Systems that modify behavior without explicit retraining\"\n    },\n    \"deceptive_alignment\": {\n      \"name\": \"Deceptive Alignment\",\n      \"status\": \"monitoring\",\n      \"description\": \"Systems hiding their true objectives\"\n    },\n    \"power_seeking_behavior\": {\n      \"name\": \"Power-Seeking Behavior\",\n      \"status\": \"monitoring\",\n      \"description\": \"Models actively acquiring resources or influence\"\n    },\n    \"specification_gaming\": {\n      \"name\": \"Specification Gaming\",\n      \"status\": \"monitoring\",\n      \"description\": \"Systems optimizing for the metric rather than the intent\"\n    },\n    \"value_misalignment\": {\n      \"name\": \"Value Misalignment\",\n      \"status\": \"monitoring\",\n      \"description\": \"Divergence between system goals and human values\"\n    }\n  },\n\n  \"risk_thresholds\": {\n    \"low\": {\n      \"score_range\": \"0-5\",\n      \"action\": \"deploy_immediately\",\n      \"monitoring\": \"standard\",\n      \"review_frequency\": \"quarterly\"\n    },\n    \"medium\": {\n      \"score_range\": \"6-8\",\n      \"action\": \"deploy_with_safeguards\",\n      \"monitoring\": \"enhanced\",\n      \"review_frequency\": \"monthly\",\n      \"requires_sag_review\": false\n    },\n    \"high\": {\n      \"score_range\": \"9-12\",\n      \"action\": \"intensive_safeguards\",\n      \"monitoring\": \"intensive\",\n      \"review_frequency\": \"weekly\",\n      \"requires_sag_review\": true,\n      \"requires_safeguards_report\": true\n    },\n    \"critical\": {\n      \"score_range\": \"13-30\",\n      \"action\": \"block_deployment\",\n      \"monitoring\": \"daily\",\n      \"review_frequency\": \"immediate\",\n      \"requires_sag_review\": true,\n      \"requires_board_approval\": true,\n      \"requires_safeguards_report\": true,\n      \"requires_independent_audit\": true\n    }\n  },\n\n  \"governance\": {\n    \"safety_advisory_group\": {\n      \"name\": \"Safety Advisory Group (SAG)\",\n      \"meets\": \"monthly\",\n      \"responsibilities\": [\n        \"Review all proposed safeguards\",\n        \"Evaluate risk assessments\",\n        \"Provide deployment recommendations\",\n        \"Escalate critical decisions to board\"\n      ],\n      \"composition\": [\n        \"Chief Safety Officer\",\n        \"External AI safety experts\",\n        \"Domain specialists\",\n        \"Threat modeling leads\",\n        \"Deployment team representatives\"\n      ]\n    },\n    \"board_review\": {\n      \"name\": \"Board-Level Review\",\n      \"authority\": \"final_veto_power\",\n      \"triggers\": [\n        \"Any Critical-rated capability post-mitigation\",\n        \"SAG cannot reach consensus\",\n        \"External escalations\",\n        \"Significant threat intelligence changes\"\n      ]\n    }\n  },\n\n  \"safeguards_report_template\": {\n    \"sections\": [\n      \"Executive Summary\",\n      \"Capability Description\",\n      \"Risk Assessment\",\n      \"Proposed Safeguards\",\n      \"Monitoring Plan\",\n      \"Independent Review Findings\",\n      \"Approval Signatures\"\n    ],\n    \"required_for\": [\"high\", \"critical\"]\n  },\n\n  \"audit_schedule\": {\n    \"internal_audit\": \"quarterly\",\n    \"external_audit\": \"annually\",\n    \"red_team_exercises\": \"semi-annually\",\n    \"penetration_testing\": \"semi-annually\",\n    \"threat_intelligence_update\": \"quarterly\"\n  },\n\n  \"incident_severity_levels\": {\n    \"critical\": {\n      \"description\": \"Deployed capability causing unintended harm\",\n      \"response_time\": \"1 hour\",\n      \"action\": \"rollback_or_shutdown\",\n      \"escalation\": \"board_and_sag\"\n    },\n    \"high\": {\n      \"description\": \"Serious safeguard failure or near-miss\",\n      \"response_time\": \"24 hours\",\n      \"action\": \"deploy_additional_safeguards\",\n      \"escalation\": \"sag\"\n    },\n    \"medium\": {\n      \"description\": \"Minor safeguard issue or false positive\",\n      \"response_time\": \"48 hours\",\n      \"action\": \"monitor_closely\",\n      \"escalation\": \"safety_team\"\n    }\n  },\n\n  \"transparency_commitments\": [\n    \"Publish Safeguards Reports for High/Critical capabilities\",\n    \"Share risk assessment methodologies\",\n    \"Disclose mitigation effectiveness data\",\n    \"Report on safety incidents and responses\",\n    \"Provide regular transparency updates\",\n    \"Support independent audits\"\n  ],\n\n  \"metrics_and_monitoring\": {\n    \"capability_metrics\": [\n      \"Model performance across risk categories\",\n      \"Mitigation effectiveness scores\",\n      \"Incident frequency and severity\",\n      \"Safeguard bypass attempts\",\n      \"User misuse reports\"\n    ],\n    \"governance_metrics\": [\n      \"SAG meeting frequency and decisions\",\n      \"Average time to risk assessment\",\n      \"Deployment approval rate\",\n      \"Time to incident resolution\",\n      \"Audit finding remediation rate\"\n    ]\n  },\n\n  \"compliance_checklist\": [\n    \"All High/Critical capabilities have Safeguards Reports\",\n    \"Risk assessments updated quarterly\",\n    \"Independent audit completed within last 12 months\",\n    \"SAG meetings documented monthly\",\n    \"Board approvals logged for all critical decisions\",\n    \"Incident response drills completed annually\",\n    \"External threat intelligence integrated quarterly\",\n    \"Staff training completed annually\",\n    \"Third-party security assessments current\",\n    \"Transparency reports published semi-annually\"\n  ]\n}\n